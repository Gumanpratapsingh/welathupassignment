						"exec": [
							"if (!pm.response.body) {",
							"    pm.test(\"response body\", function () { pm.expect.fail('Missing body'); });",
							"    return;",
							"}",
							"const jsonData = pm.response.json();",
							"const fileId = jsonData?.files?.[0]?._id;",
							"if (fileId) {",
							"    pm.collectionVariables.set('sampleFileId', fileId);",
							"    console.log('Set sampleFileId to', fileId);",
							"}"
